#usda 1.0
(
    customLayerData = {
        string creator = "URDF USD Converter v0.1.2"
    }
    defaultPrim = "amov_drone"
    kilogramsPerUnit = 1
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "amov_drone"
{
    def Scope "Materials"
    {
        def Material "material_1" (
            prepend references = @./MaterialsLibrary.usdc@</Materials/material_1>
        )
        {
        }

        def Material "material_2" (
            prepend references = @./MaterialsLibrary.usdc@</Materials/material_2>
        )
        {
        }

        def Material "material_3" (
            prepend references = @./MaterialsLibrary.usdc@</Materials/material_3>
        )
        {
        }

        def Material "material_4" (
            prepend references = @./MaterialsLibrary.usdc@</Materials/material_4>
        )
        {
        }

        def Material "material_5" (
            prepend references = @./MaterialsLibrary.usdc@</Materials/material_5>
        )
        {
        }
    }

    over "Geometry"
    {
        over "base_link"
        {
            over "base_link" (
                prepend apiSchemas = ["MaterialBindingAPI"]
            )
            {
                rel material:binding = </amov_drone/Materials/material_1>
            }

            over "rotor_link_1"
            {
                over "rotor_link_1" (
                    prepend apiSchemas = ["MaterialBindingAPI"]
                )
                {
                    rel material:binding = </amov_drone/Materials/material_2>
                }
            }

            over "rotor_link_2"
            {
                over "rotor_link_2" (
                    prepend apiSchemas = ["MaterialBindingAPI"]
                )
                {
                    rel material:binding = </amov_drone/Materials/material_3>
                }
            }

            over "rotor_link_3"
            {
                over "rotor_link_3" (
                    prepend apiSchemas = ["MaterialBindingAPI"]
                )
                {
                    rel material:binding = </amov_drone/Materials/material_4>
                }
            }

            over "rotor_link_4"
            {
                over "rotor_link_4" (
                    prepend apiSchemas = ["MaterialBindingAPI"]
                )
                {
                    rel material:binding = </amov_drone/Materials/material_5>
                }
            }
        }
    }
}

